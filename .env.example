# ========================================================
# CONFIGURATION SMTP POUR CANDIDATURES SPONTANEES
# ========================================================
# Pour Gmail : utilisez un "Mot de passe d'application" (pas votre mot de passe habituel)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_email@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_application_google
SENDER_EMAIL=votre_email@gmail.com
SENDER_NAME=Bastien Poissonnet

# Temporisation aléatoire entre chaque envoi de mail (secondes) pour protection anti-spam
SMTP_DELAY_MIN=5
SMTP_DELAY_MAX=15

# ========================================================
# OPTIONS DE RECHERCHE
# ========================================================
# Seuil de score minimal pour retenir une offre (sur 100)
MIN_SCORE_THRESHOLD=40

# Limite d'offres récupérées par source
MAX_OFFERS_PER_SOURCE=30
